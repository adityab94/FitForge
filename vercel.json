{
  "buildCommand": "cd api && npm install && cd ../frontend && yarn install && yarn build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/weekly-coach", "schedule": "30 14 * * 0" }
  ]
}
